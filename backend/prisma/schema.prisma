datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ACADEMICIAN
  INDUSTRY
  INSTITUTION_ADMIN
  SUPER_ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile Student?
  industryProfile Industry?
}

model Student {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  phone           String?
  location        String?
  bio             String?
  institution     String?
  degree          String?
  department      String?
  graduationYear  Int?
  cgpa            Float?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Industry {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  description     String?
  industryDomain  String?
  website         String?
  location        String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
